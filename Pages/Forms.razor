@page "/forms"

<PageTitle>Forms - MudBlazor Learning</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">Forms e Input</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    I form permettono di raccogliere input dall'utente. MudBlazor offre una vasta gamma di componenti di input.
</MudText>

<MudGrid>
    <!-- Text Fields -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Text Fields</MudText>

            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_textValue"
                                  Label="Text Field Base"
                                  Variant="Variant.Filled" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_textValue"
                                  Label="Outlined"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_textValue"
                                  Label="Text (No border)"
                                  Variant="Variant.Text" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_emailValue"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Email" />
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_passwordValue"
                                  Label="Password"
                                  Variant="Variant.Outlined"
                                  InputType="@_passwordInput"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                  OnAdornmentClick="TogglePasswordVisibility" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_multilineValue"
                                  Label="Textarea Multilinea"
                                  Variant="Variant.Outlined"
                                  Lines="4" />
                </MudItem>
            </MudGrid>

            <MudPaper Class="code-block mt-4">
                <pre>@(@"<MudTextField @bind-Value=""_textValue""
              Label=""Nome""
              Variant=""Variant.Outlined"" />

@code {
    private string _textValue = """";
}")</pre>
            </MudPaper>
        </MudPaper>
    </MudItem>

    <!-- Numeric Fields -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Campi Numerici</MudText>

            <MudNumericField @bind-Value="_intValue"
                             Label="Intero"
                             Variant="Variant.Outlined"
                             Min="0"
                             Max="100" />

            <MudNumericField @bind-Value="_decimalValue"
                             Label="Decimale"
                             Variant="Variant.Outlined"
                             Class="mt-4"
                             Step="0.01M" />

            <MudText Typo="Typo.body2" Class="mt-2">
                Valore: @_intValue | Decimale: @_decimalValue
            </MudText>
        </MudPaper>
    </MudItem>

    <!-- Select -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Select (Selezione)</MudText>

            <MudSelect @bind-Value="_selectedCity"
                       Label="Città"
                       Variant="Variant.Outlined">
                <MudSelectItem Value="@("Milano")">Milano</MudSelectItem>
                <MudSelectItem Value="@("Roma")">Roma</MudSelectItem>
                <MudSelectItem Value="@("Napoli")">Napoli</MudSelectItem>
                <MudSelectItem Value="@("Torino")">Torino</MudSelectItem>
            </MudSelect>

            <MudSelect @bind-Value="_selectedLanguage"
                       Label="Linguaggio"
                       Variant="Variant.Outlined"
                       Class="mt-4"
                       T="string"
                       MultiSelection="false">
                @foreach (var lang in _languages)
                {
                    <MudSelectItem Value="@lang">@lang</MudSelectItem>
                }
            </MudSelect>

            <MudText Typo="Typo.body2" Class="mt-2">
                Selezione: @_selectedCity, @_selectedLanguage
            </MudText>
        </MudPaper>
    </MudItem>

    <!-- Checkboxes and Switches -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Checkbox e Switch</MudText>

            <MudCheckBox T="bool" @bind-Checked="_checkboxValue" Color="Color.Primary">
                Accetto i termini e condizioni
            </MudCheckBox>

            <MudCheckBox T="bool" @bind-Checked="_checkbox2Value" Color="Color.Secondary">
                Iscrivimi alla newsletter
            </MudCheckBox>

            <MudDivider Class="my-4" />

            <MudSwitch T="bool" @bind-Checked="_switchValue" Color="Color.Primary">
                Notifiche attive
            </MudSwitch>

            <MudSwitch T="bool" @bind-Checked="_switch2Value" Color="Color.Success">
                Modalità scura
            </MudSwitch>

            <MudText Typo="Typo.body2" Class="mt-2">
                Checkbox: @_checkboxValue | Switch: @_switchValue
            </MudText>
        </MudPaper>
    </MudItem>

    <!-- Radio Buttons -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Radio Buttons</MudText>

            <MudRadioGroup T="string" @bind-SelectedOption="_selectedOption">
                <MudRadio T="string" Option="@("option1")" Color="Color.Primary">Opzione 1</MudRadio>
                <MudRadio T="string" Option="@("option2")" Color="Color.Secondary">Opzione 2</MudRadio>
                <MudRadio T="string" Option="@("option3")" Color="Color.Tertiary">Opzione 3</MudRadio>
            </MudRadioGroup>

            <MudText Typo="Typo.body2" Class="mt-2">
                Selezionato: @_selectedOption
            </MudText>
        </MudPaper>
    </MudItem>

    <!-- Date and Time -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Data e Ora</MudText>

            <MudDatePicker @bind-Date="_selectedDate"
                           Label="Seleziona Data"
                           Variant="Variant.Outlined" />

            <MudTimePicker @bind-Time="_selectedTime"
                           Label="Seleziona Ora"
                           Variant="Variant.Outlined"
                           Class="mt-4" />

            <MudText Typo="Typo.body2" Class="mt-2">
                Data: @_selectedDate?.ToString("dd/MM/yyyy") | Ora: @_selectedTime
            </MudText>
        </MudPaper>
    </MudItem>

    <!-- Slider and Rating -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Slider e Rating</MudText>

            <MudText Typo="Typo.body2">Volume: @_sliderValue</MudText>
            <MudSlider @bind-Value="_sliderValue" Min="0" Max="100" Step="1" Color="Color.Primary" />

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.body2">Valutazione: @_ratingValue stelle</MudText>
            <MudRating @bind-SelectedValue="_ratingValue" />
        </MudPaper>
    </MudItem>

    <!-- Form Completo -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Form Completo di Esempio</MudText>

            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_formName"
                                  Label="Nome Completo"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_formEmail"
                                  Label="Email"
                                  Variant="Variant.Outlined"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_formMessage"
                                  Label="Messaggio"
                                  Variant="Variant.Outlined"
                                  Lines="4" />
                </MudItem>
                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SubmitForm"
                               StartIcon="@Icons.Material.Filled.Send">
                        Invia
                    </MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    // Text fields
    private string _textValue = "";
    private string _emailValue = "";
    private string _passwordValue = "";
    private string _multilineValue = "";
    private bool _showPassword = false;
    private InputType _passwordInput = InputType.Password;

    // Numeric fields
    private int _intValue = 50;
    private decimal _decimalValue = 10.5M;

    // Select
    private string _selectedCity = "Milano";
    private string _selectedLanguage = "C#";
    private List<string> _languages = new() { "C#", "Java", "Python", "JavaScript", "Go" };

    // Checkboxes and Switches
    private bool _checkboxValue = false;
    private bool _checkbox2Value = false;
    private bool _switchValue = true;
    private bool _switch2Value = false;

    // Radio
    private string _selectedOption = "option1";

    // Date and Time
    private DateTime? _selectedDate = DateTime.Today;
    private TimeSpan? _selectedTime = TimeSpan.FromHours(12);

    // Slider and Rating
    private int _sliderValue = 50;
    private int _ratingValue = 3;

    // Form completo
    private string _formName = "";
    private string _formEmail = "";
    private string _formMessage = "";

    void TogglePasswordVisibility()
    {
        if (_showPassword)
        {
            _showPassword = false;
            _passwordInput = InputType.Password;
        }
        else
        {
            _showPassword = true;
            _passwordInput = InputType.Text;
        }
    }

    void SubmitForm()
    {
        // Qui andresti a processare il form
        // Per ora solo un messaggio console (visibile nei dev tools del browser)
        Console.WriteLine($"Form inviato: {_formName}, {_formEmail}");
    }
}
