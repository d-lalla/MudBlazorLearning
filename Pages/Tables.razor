        new Person { FirstName = "Laura", LastName = "Blu", Age = 31, City = "Firenze", Email = "laura.blu@email.it" },
        new Person { FirstName = "Marco", LastName = "Rosa", Age = 29, City = "Venezia", Email = "marco.rosa@email.it" },
        new Person { FirstName = "Sara", LastName = "Viola", Age = 33, City = "Genova", Email = "sara.viola@email.it" },
        new Person { FirstName = "Alessandro", LastName = "Arancio", Age = 27, City = "Palermo", Email = "alessandro.arancio@email.it" },
        new Person { FirstName = "Francesca", LastName = "Marrone", Age = 38, City = "Bari", Email = "francesca.marrone@email.it" }
    };

    private List<PersonWithRole> _actionData = new()
    {
        new PersonWithRole { FirstName = "Mario", LastName = "Rossi", Role = "Admin", IsActive = true },
        new PersonWithRole { FirstName = "Giulia", LastName = "Bianchi", Role = "Developer", IsActive = true },
        new PersonWithRole { FirstName = "Luca", LastName = "Verdi", Role = "Designer", IsActive = false },
