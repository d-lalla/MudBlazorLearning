        new Product { Name = "Laptop", Price = 1200, Quantity = 2 },
        new Product { Name = "Mouse", Price = 25, Quantity = 5 },
        new Product { Name = "Tastiera", Price = 80, Quantity = 3 }
    };

    private void EditPerson(PersonWithRole person)
    {
        Console.WriteLine($"Modifica: {person.FirstName} {person.LastName}");
    }

    private void DeletePerson(PersonWithRole person)
    {
        Console.WriteLine($"Elimina: {person.FirstName} {person.LastName}");
    }

    // Model classes
    public class Person
    {
        public string FirstName { get; set; } = "";
        public string LastName { get; set; } = "";
        public int Age { get; set; }
        public string City { get; set; } = "";
        public string Email { get; set; } = "";
        public string Role { get; set; } = "";
    }

    public class PersonWithRole : Person
    {
        public bool IsActive { get; set; }
    }

    public class Product
    {
        public string Name { get; set; } = "";
        public decimal Price { get; set; }
        public int Quantity { get; set; }
    }
}
