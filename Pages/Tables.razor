@page "/tables"

<PageTitle>Tabelle - MudBlazor Learning</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">Tabelle</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    Le tabelle MudBlazor sono potenti e flessibili, con supporto per sorting, filtering, paginazione e altro.
</MudText>

<MudGrid>
    <!-- Tabella Base -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Tabella Base</MudText>

            <MudTable Items="@_simpleData" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>Cognome</MudTh>
                    <MudTh>Età</MudTh>
                    <MudTh>Città</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.FirstName</MudTd>
                    <MudTd DataLabel="Cognome">@context.LastName</MudTd>
                    <MudTd DataLabel="Età">@context.Age</MudTd>
                    <MudTd DataLabel="Città">@context.City</MudTd>
                </RowTemplate>
            </MudTable>

            <MudPaper Class="code-block mt-4">
                <pre>@(@"<MudTable Items=""@_simpleData"" Hover=""true"">
    <HeaderContent>
        <MudTh>Nome</MudTh>
        <MudTh>Cognome</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.FirstName</MudTd>
        <MudTd>@context.LastName</MudTd>
    </RowTemplate>
</MudTable>")</pre>
            </MudPaper>
        </MudPaper>
    </MudItem>

    <!-- Tabella con Sorting -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Tabella con Sorting</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Clicca sulle intestazioni per ordinare</MudText>

            <MudTable Items="@_sortableData" Hover="true" SortLabel="Ordina per" Dense="true">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<Person, object>(x => x.FirstName)">Nome</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<Person, object>(x => x.LastName)">Cognome</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel InitialDirection="SortDirection.Ascending" SortBy="new Func<Person, object>(x => x.Age)">Età</MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<Person, object>(x => x.City)">Città</MudTableSortLabel></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.FirstName</MudTd>
                    <MudTd DataLabel="Cognome">@context.LastName</MudTd>
                    <MudTd DataLabel="Età">@context.Age</MudTd>
                    <MudTd DataLabel="Città">@context.City</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- Tabella con Paginazione -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Tabella con Paginazione</MudText>

            <MudTable Items="@_paginatedData"
                      Hover="true"
                      Dense="true"
                      Striped="true"
                      @bind-SelectedItem="_selectedPerson"
                      RowsPerPage="5">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>Cognome</MudTh>
                    <MudTh>Età</MudTh>
                    <MudTh>Città</MudTh>
                    <MudTh>Email</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.FirstName</MudTd>
                    <MudTd DataLabel="Cognome">@context.LastName</MudTd>
                    <MudTd DataLabel="Età">@context.Age</MudTd>
                    <MudTd DataLabel="Città">@context.City</MudTd>
                    <MudTd DataLabel="Email">@context.Email</MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[]{5, 10, 25, 50}" />
                </PagerContent>
            </MudTable>

            @if (_selectedPerson != null)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">
                    Selezionato: @_selectedPerson.FirstName @_selectedPerson.LastName
                </MudAlert>
            }
        </MudPaper>
    </MudItem>

    <!-- Tabella con Azioni -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Tabella con Azioni</MudText>

            <MudTable Items="@_actionData" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Nome</MudTh>
                    <MudTh>Ruolo</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Azioni</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Nome">@context.FirstName @context.LastName</MudTd>
                    <MudTd DataLabel="Ruolo">@context.Role</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small"
                                 Color="@(context.IsActive ? Color.Success : Color.Default)">
                            @(context.IsActive ? "Attivo" : "Inattivo")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Azioni">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditPerson(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeletePerson(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>

    <!-- Simple Table (più leggera) -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Simple Table</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Tabella semplice senza funzionalità avanzate (più leggera)</MudText>

            <MudSimpleTable Hover="true" Dense="true" Striped="true">
                <thead>
                    <tr>
                        <th>Prodotto</th>
                        <th>Prezzo</th>
                        <th>Quantità</th>
                        <th>Totale</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _products)
                    {
                        <tr>
                            <td>@item.Name</td>
                            <td>€@item.Price.ToString("N2")</td>
                            <td>@item.Quantity</td>
                            <td>€@((item.Price * item.Quantity).ToString("N2"))</td>
                        </tr>
                    }
                    <tr>
                        <td colspan="3"><strong>Totale</strong></td>
                        <td><strong>€@_products.Sum(p => p.Price * p.Quantity).ToString("N2")</strong></td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>
</MudGrid>

