        new Person { FirstName = "Giulia", LastName = "Bianchi", Age = 25, City = "Roma", Email = "giulia.bianchi@email.it" },
        new Person { FirstName = "Luca", LastName = "Verdi", Age = 35, City = "Napoli", Email = "luca.verdi@email.it" },
