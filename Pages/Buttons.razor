@page "/buttons"

<PageTitle>Bottoni - MudBlazor Learning</PageTitle>

<MudText Typo="Typo.h3" Class="mb-4">Bottoni</MudText>
<MudText Typo="Typo.body1" Class="mb-4">
    I bottoni sono componenti fondamentali per l'interazione utente.
</MudText>

<MudGrid>
    <!-- Varianti di base -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Varianti di Base</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Tre varianti principali: Filled (default), Outlined, Text</MudText>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Filled</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary">Outlined</MudButton>
                <MudButton Variant="Variant.Text" Color="Color.Primary">Text</MudButton>
            </div>

            <MudPaper Class="code-block">
                <pre>@(@"<MudButton Variant=""Variant.Filled"" Color=""Color.Primary"">Filled</MudButton>
<MudButton Variant=""Variant.Outlined"" Color=""Color.Primary"">Outlined</MudButton>
<MudButton Variant=""Variant.Text"" Color=""Color.Primary"">Text</MudButton>")</pre>
            </MudPaper>
        </MudPaper>
    </MudItem>

    <!-- Colori -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Colori Disponibili</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">MudBlazor offre una palette completa di colori</MudText>

            <div class="d-flex flex-wrap gap-2 mb-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary">Primary</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary">Secondary</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Tertiary">Tertiary</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info">Info</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success">Success</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Warning">Warning</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error">Error</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Dark">Dark</MudButton>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Dimensioni -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Dimensioni</MudText>

            <div class="d-flex flex-column gap-2 align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small">Small</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Medium">Medium (default)</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large">Large</MudButton>
            </div>
        </MudPaper>
    </MudItem>

    <!-- Con Icone -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Bottoni con Icone</MudText>

            <div class="d-flex flex-column gap-2 align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save">
                    Salva
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.Delete">
                    Elimina
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Success"
                           EndIcon="@Icons.Material.Filled.Send">
                    Invia
                </MudButton>
            </div>

            <MudPaper Class="code-block mt-4">
                <pre>@(@"<MudButton StartIcon=""@Icons.Material.Filled.Save"">
    Salva
</MudButton>")</pre>
            </MudPaper>
        </MudPaper>
    </MudItem>

    <!-- Icon Buttons -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Icon Buttons</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Solo icone, perfetti per toolbar</MudText>

            <div class="d-flex flex-wrap gap-2">
                <MudIconButton Icon="@Icons.Material.Filled.Home" Color="Color.Primary" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Secondary" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" />
                <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Info" />
                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" />
            </div>
        </MudPaper>
    </MudItem>

    <!-- Stati e Interazioni -->
    <MudItem xs="12" md="6">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Stati e Interazioni</MudText>

            <div class="d-flex flex-column gap-2 align-start">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           OnClick="@(() => _clickCount++)">
                    Cliccato @_clickCount volte
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="true">
                    Disabilitato
                </MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true">
                    Full Width
                </MudButton>
            </div>

            <MudPaper Class="code-block mt-4">
                <pre>@(@"<MudButton OnClick=""@(() => _clickCount++)"">
    Cliccato @_clickCount volte
</MudButton>

@code {
    private int _clickCount = 0;
}")</pre>
            </MudPaper>
        </MudPaper>
    </MudItem>

    <!-- Button Group -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Button Group</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Raggruppa bottoni correlati</MudText>

            <MudButtonGroup Color="Color.Primary" Variant="Variant.Outlined">
                <MudButton>Sinistra</MudButton>
                <MudButton>Centro</MudButton>
                <MudButton>Destra</MudButton>
            </MudButtonGroup>

            <MudDivider Class="my-4" />

            <MudButtonGroup Color="Color.Secondary" Variant="Variant.Filled" OverrideStyles="false">
                <MudButton StartIcon="@Icons.Material.Filled.Save">Salva</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Print">Stampa</MudButton>
                <MudButton StartIcon="@Icons.Material.Filled.Share">Condividi</MudButton>
            </MudButtonGroup>
        </MudPaper>
    </MudItem>

    <!-- Floating Action Button -->
    <MudItem xs="12">
        <MudPaper Elevation="2" Class="pa-4">
            <MudText Typo="Typo.h6" Class="mb-4">Floating Action Button (FAB)</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Bottoni circolari per azioni primarie</MudText>

            <div class="d-flex flex-wrap gap-4 align-center">
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" />
                <MudFab Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Edit" />
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Small" />
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Size="Size.Large" />
                <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Favorite" Label="Extended FAB" />
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private int _clickCount = 0;
}
